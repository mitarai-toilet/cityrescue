{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "campus",
  "type": "object",
  "required": [
    "campus_id",
    "name",
    "coordinate_system",
    "data_origin",
    "data_source",
    "verified"
  ],
  "properties": {
    "campus_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_system": {
      "const": "WGS84"
    },
    "data_origin": {
      "enum": [
        "real",
        "estimated",
        "synthetic"
      ]
    },
    "data_source": {
      "type": "string",
      "minLength": 1
    },
    "verified": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
