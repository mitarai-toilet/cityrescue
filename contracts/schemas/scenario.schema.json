{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scenario",
  "type": "object",
  "required": [
    "scenario_id",
    "campus_id",
    "hazard_type",
    "params",
    "duration_min",
    "step_min",
    "seed"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "campus_id": {
      "type": "string",
      "minLength": 1
    },
    "hazard_type": {
      "enum": [
        "flood",
        "earthquake"
      ]
    },
    "params": {
      "type": "object"
    },
    "duration_min": {
      "type": "integer",
      "minimum": 1
    },
    "step_min": {
      "type": "integer",
      "minimum": 1
    },
    "seed": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
