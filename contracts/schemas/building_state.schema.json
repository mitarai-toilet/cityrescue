{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "building_state",
  "type": "object",
  "required": [
    "building_id",
    "time_min",
    "risk_level",
    "reason"
  ],
  "properties": {
    "building_id": {
      "type": "string",
      "minLength": 1
    },
    "time_min": {
      "type": "integer",
      "minimum": 0
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
