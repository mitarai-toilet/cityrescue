{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "node",
  "type": "object",
  "required": [
    "node_id",
    "position"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "position": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
