{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "explain_result",
  "type": "object",
  "required": [
    "run_id",
    "state_version",
    "summary",
    "evidence_ids",
    "limitations"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
