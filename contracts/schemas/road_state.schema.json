{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "road_state",
  "type": "object",
  "required": [
    "road_id",
    "time_min",
    "status",
    "depth_m",
    "risk_penalty_min",
    "reason"
  ],
  "properties": {
    "road_id": {
      "type": "string",
      "minLength": 1
    },
    "time_min": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "open",
        "caution",
        "closed"
      ]
    },
    "depth_m": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "risk_penalty_min": {
      "type": "number",
      "minimum": 0
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "hazard",
        "manual",
        "baseline"
      ]
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
