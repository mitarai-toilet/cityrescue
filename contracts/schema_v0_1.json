{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cityrescue.local/contracts/schema-v0.1.json",
  "title": "CITYRESCUE v0.1 compatibility aggregate",
  "description": "Compatibility envelope. Canonical entity definitions are contracts/schemas/*.schema.json.",
  "type": "object",
  "required": [
    "contract_version",
    "campus",
    "nodes",
    "roads",
    "buildings",
    "scenario",
    "road_states",
    "building_states",
    "vehicles",
    "events",
    "dispatch_result",
    "explain_result"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1"
    },
    "campus": {
      "$ref": "schemas/campus.schema.json"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "schemas/node.schema.json"
      }
    },
    "roads": {
      "type": "array",
      "items": {
        "$ref": "schemas/road.schema.json"
      }
    },
    "buildings": {
      "type": "array",
      "items": {
        "$ref": "schemas/building.schema.json"
      }
    },
    "scenario": {
      "$ref": "schemas/scenario.schema.json"
    },
    "road_states": {
      "type": "array",
      "items": {
        "$ref": "schemas/road_state.schema.json"
      }
    },
    "building_states": {
      "type": "array",
      "items": {
        "$ref": "schemas/building_state.schema.json"
      }
    },
    "vehicles": {
      "type": "array",
      "items": {
        "$ref": "schemas/vehicle.schema.json"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "schemas/event.schema.json"
      }
    },
    "dispatch_result": {
      "$ref": "schemas/dispatch_result.schema.json"
    },
    "explain_result": {
      "$ref": "schemas/explain_result.schema.json"
    },
    "$comment": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
